{
  "name": "pocket_gita",
  "version": "1.0.0",
  "description": "Bhagavat Gita & Shrimad Bhagavatam in your pocket",
  "main": "index.js",
  "scripts": {
    "reset": "node index.js --action init",
    "parse_chapters": "node index.js --action chapters --engine gitabase --url https://gitabase.com/ukr/BG --abbr bg --lang ukr --levels 2",
    "parse_content": "node index.js --action content --book_id 1",
    "parse_file": "node index.js --action file --engine gitabase gitabase.json",
    "delete_book": "node index.js --action delete --book_id 2",
    "retry": "node index.js --action retry --book_id 1",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f mariadb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breakeneck/gitaparser.git"
  },
  "keywords": [
    "gita"
  ],
  "author": "Yuri Datsenko",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/breakeneck/gitaparser/issues"
  },
  "homepage": "https://github.com/breakeneck/gitaparser#readme",
  "dependencies": {
    "axios": "^1.6.1",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "minimist": "^1.2.8",
    "mysql2": "^3.6.5",
    "play-sound": "^1.1.6"
  }
}
